# Copy to .env and fill in. Never commit .env.
CORS_ORIGINS=http://localhost:5173

# Local database (docker compose up -d db)
DATABASE_URL=postgresql://touchgrass:localdev@localhost:5432/touchgrass

# Server-side keys only. These never go to the browser.
GOOGLE_MAPS_API_KEY=

# App access gate. Set both values outside local development.
ACCESS_PASSWORD=
ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_TTL_SECONDS=3600
