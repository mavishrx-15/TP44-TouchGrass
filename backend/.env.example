# Copy to .env and fill in. Never commit .env.
CORS_ORIGINS=http://localhost:5173

# Supabase (Postgres). Project Settings -> Database -> Connection string -> URI.
DATABASE_URL=postgresql+psycopg2://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres

# Or run against a local SQLite file, loaded from backend/dataset, when you
# just want the API up without touching the shared database:
# DATABASE_URL=sqlite:///./touchgrass.db

# Server-side keys only. These never go to the browser.
GOOGLE_MAPS_API_KEY=

# App access gate. Required in every environment.
# Generate a signing secret with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# ACCESS_TOKEN_SECRET must contain at least 32 bytes.
ACCESS_PASSWORD=
ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_TTL_SECONDS=3600

# Optional: override the CBD polygon, JSON [longitude, latitude] ring.
# The default is the Hoddle Grid outline described in database/CBD_API.md.
# CBD_BOUNDARY=[[144.954098,-37.822128],[144.975427,-37.815891],[144.971426,-37.807191],[144.95007,-37.813376],[144.954098,-37.822128]]

# Provisional spam limit for tree pins and messages, to be agreed with the security lead.
# Set to 0 in your local .env for unlimited development posts. Production defaults to 10.
POSTS_PER_DEVICE_PER_HOUR=10
