# Copy to .env and fill in. Never commit .env.
CORS_ORIGINS=http://localhost:5173

# Supabase (Postgres). Project Settings -> Database -> Connection string -> URI.
DATABASE_URL=postgresql+psycopg2://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres

# Or run against a local SQLite file, loaded from backend/dataset, when you
# just want the API up without touching the shared database:
# DATABASE_URL=sqlite:///./touchgrass.db

# Server-side keys only. These never go to the browser.
GOOGLE_MAPS_API_KEY=

# New Iteration 3 routes require Authorization: Bearer <ACCESS_TOKEN>.
ACCESS_TOKEN=
# This shared bearer credential is not user authentication; never expose it to browser code.

# Required, authoritative GeoJSON Polygon/MultiPolygon for Hoddle Grid.
# Do not substitute a precinct or a guessed bounding box.
CBD_BOUNDARY_GEOJSON=

# Required only when uploading pin photos. Bucket must be private.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=tree-photos

# Comma-separated trees.common_name values designated high pollen.
# Without this list, pollen exposure is explicitly unverified.
HIGH_POLLEN_SPECIES=
