# Copy to .env.local and fill in. Never commit .env.local.
VITE_API_BASE_URL=http://localhost:8080
# Browser-side Maps key. Restrict by HTTP referrer and by API in the console.
# Paid APIs (Routes, Places) are called from the backend, not from here.
VITE_GOOGLE_MAPS_API_KEY=
# Optional custom vector map ID. The Google demo map ID is used locally when omitted.
VITE_GOOGLE_MAP_ID=
